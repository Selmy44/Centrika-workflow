# Example Postgres connection string
DATABASE_URL=postgres://postgres:postgres@db:5432/oneportal

# Optional PORT override
PORT=3000

# JWT / cookie secret used by auth
COOKIE_SECRET=change-me

# App ID or other envs
APP_ID=centrika_local

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@centrika.rw

# Database credentials for docker-compose
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=oneportal

# OAuth Configuration
OAUTH_SERVER_URL=

# Redis Configuration (Use "redis" as host in Docker)
REDIS_HOST=redis
REDIS_PORT=6379

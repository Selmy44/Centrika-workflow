{
  "name": "centrika-backend",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --external:*.css --outdir=dist --format=esm",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "seed": "tsx scripts/seedHeads.ts",
    "seed:users": "tsx scripts/seedUsers.ts",
    "seed:departments": "tsx scripts/seedDepartments.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@trpc/server": "^11.12.0",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "cookie": "^1.1.1",
    "crypto-random-string": "^5.0.0",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "jose": "^6.1.0",
    "nodemailer": "^6.10.1",
    "postgres": "^3.4.8",
    "redis": "^4.7.1",
    "speakeasy": "^2.0.0",
    "superjson": "^2.2.6",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@prisma/client": "^6.2.1",
    "@prisma/config": "^7.5.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.18.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.1",
    "typescript": "^5.7.0"
  }
}

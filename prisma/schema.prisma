model AnnouncementPoll {
  id                Int       @id @default(autoincrement())
  announcementId    Int       @unique @map("announcement_id")
  question          String    @db.VarChar(300)
  preset            String    @default("yes_no") @db.VarChar(20) // yes_no, agree_disagree, approve_reject, custom
  isAnonymous       Boolean   @default(false) @map("is_anonymous")
  allowChangeVote   Boolean   @default(true) @map("allow_change_vote")
  resultsVisibility String    @default("always") @map("results_visibility") @db.VarChar(20) // always, after_vote, after_close
  closesAt          DateTime? @map("closes_at")

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "lib": [
      "ES2022"
    ],
    "baseUrl": ".",
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "drizzle"
  ]
}
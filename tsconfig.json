{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "lib": [
      "ESNext"
    ],
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "scripts",
    "*.ts"
  ]
}
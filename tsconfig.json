{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "jsx": "react-jsx",
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "types": [
            "node",
            "vite/client"
        ],
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "react": ["./frontend/node_modules/@types/react"],
            "react-dom": ["./frontend/node_modules/@types/react-dom"],
            "react-dom/*": ["./frontend/node_modules/@types/react-dom/*"],
            "react/jsx-runtime": ["./frontend/node_modules/@types/react/jsx-runtime"],
            "lucide-react": ["./frontend/node_modules/lucide-react"]
        },
        "typeRoots": [
            "./frontend/node_modules/@types",
            "./frontend/node_modules"
        ]
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "backend",
        "frontend"
    ]
}